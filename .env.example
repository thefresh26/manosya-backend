# Copia este archivo como ".env" en esta misma carpeta y pon tus valores
# reales. El ".env" real nunca se sube a git (ver .gitignore).

# Cadena de conexión de tu base de datos en Neon (Settings -> Connection string).
DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/nombre_db?sslmode=require

# Clave secreta para firmar los tokens de sesión (JWT). Genera una propia,
# por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Minutos que dura una sesión antes de tener que volver a iniciar sesión.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# URL(s) del frontend que pueden llamar a esta API (separadas por coma si
# hay más de una). En local es Vite; en producción, la URL real que te dé
# Render para el frontend, por ejemplo: https://manosya-frontend.onrender.com
FRONTEND_URL=http://localhost:5173
